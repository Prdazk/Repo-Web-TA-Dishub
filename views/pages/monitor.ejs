<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CCTV Monitor</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Orbitron:wght@500&display=swap"
    rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <link href="/styles/monitor.css" rel="stylesheet" />
  <style>

.monitor-wrapper {
  display: flex;
  gap: 16px;
  padding: 16px;
  align-items: stretch;
}

.app {
  flex: 1;
  min-width: 0;
}

.detection-panel {
  width: 220px;
  flex-shrink: 0;
  background: #0f172a;
  border: 1px solid #1e293b;
  border-radius: 16px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  justify-content: space-between; 
  height: fit-content;            
  position: sticky;               
  top: 92px;
}

.detection-panel h3 {
  margin: 0 0 8px;
  font-size: 14px;
  font-weight: 700;
  color: #f97316;
  border-bottom: 1px solid #1e293b;
  padding-bottom: 8px;
}

.count-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1e293b;
  border-radius: 10px;
  padding: 10px 12px;
}

.count-item .icon-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #94a3b8;
}

.count-item .value {
  font-size: 20px;
  font-weight: 800;
  color: #f1f5f9;
}

.count-item.total {
  background: #f97316;
  margin-top: 4px;
}

.count-item.total .icon-label {
  color: #fff;
  font-weight: 700;
}

.count-item.total .value {
  color: #fff;
  font-size: 22px;
}

.panel-update {
  font-size: 10px;
  color: #475569;
  text-align: center;
  margin-top: 4px;
}

.panel-status {
  font-size: 11px;
  text-align: center;
  padding: 6px;
  border-radius: 8px;
  background: #134e4a;
  color: #34d399;
}

@media (max-width: 768px) {
  .monitor-wrapper {
    flex-direction: column;
  }
  .detection-panel {
    width: 100%;
  }
}

</style>
  <link rel="icon" href="../../logo.png" />
</head>

<body>
  <div class="top-nav">
    <button class="back-btn" onclick="goBack()">← Kembali</button>
    <div class="nav-title">CCTV MONITOR</div>
  </div>

  <template id="video-template">
    <div class="card video-card">
      <div class="video-wrapper">
        <div class="overlay">Connecting…</div>
        <video autoplay muted playsinline></video>
      </div>
      <div class="controls">
        <button class="btn zoom-in">
          <i class="fa fa-search-plus" aria-hidden="true"></i> Zoom
        </button>
        <button class="btn zoom-out">
          <i class="fa fa-search-minus" aria-hidden="true"></i> Zoom
        </button>
        <button class="btn reset">Reset</button>
        <button class="btn fullscreen">
          <i class="fa fa-arrows-alt" aria-hidden="true"></i> Fullscreen
        </button>
        <strong class="label"></strong>
      </div>
    </div>
  </template>

  <div class="monitor-wrapper">

  <div class="app"></div>

  <div class="detection-panel">
    <h3><i class="fa fa-video-camera"></i> Deteksi Real-time</h3>

    <div class="count-item">
      <div class="icon-label"><span><i class="fa fa-motorcycle" aria-hidden="true"></i></span> Motor</div>
      <span class="value" id="cnt-motorcycle">-</span>
    </div>

    <div class="count-item">
      <div class="icon-label"><span><i class="fa fa-car" aria-hidden="true"></i></span> Mobil</div>
      <span class="value" id="cnt-car">-</span>
    </div>

    <div class="count-item">
      <div class="icon-label"><span><i class="fa fa-bus" aria-hidden="true"></i></span> Bus</div>
      <span class="value" id="cnt-bus">-</span>
    </div>

    <div class="count-item">
      <div class="icon-label"><span><i class="fa fa-truck" aria-hidden="true"></i></span> Truk</div>
      <span class="value" id="cnt-truck">-</span>
    </div>

    <div class="count-item total">
      <div class="icon-label"><span><i class="fa fa-bar-chart" aria-hidden="true"></i></span> Total</div>
      <span class="value" id="cnt-total">-</span>
    </div>

    <div class="panel-status" id="panel-status"><i class="fa fa-spinner fa-spin"></i> Menghubungkan...</div>
    <div class="panel-update" id="panel-update"></div>
  </div>

</div>

  <div class="info">
    <div class="info-item">
      <div class="info-title">
        <i class="fa fa-map-marker" aria-hidden="true"></i> | Lokasi
      </div>
      <div class="info-value">
        <%= stream.lokasi %>
      </div>
    </div>
    <div class="info-item">
      <div class="info-title">
        <i class="fa fa-sort-amount-desc" aria-hidden="true"></i> | Stream
      </div>
      <div class="info-value" id="message-health"></div>
    </div>
  </div>

  <script>
    function goBack() {
      if (history.length > 1) history.back();
      else location.href = "/";
    }

    monitor();

    async function monitor(SHOW_RAW_STREAM = false) {
      const queryString = window.location.search;
      const urlParams = new URLSearchParams(queryString);
      const raw = urlParams.get("raw");
      const app = document.querySelector(".app");
      const template = document.getElementById("video-template");

      const videoConfigs = [
        { label: "", url: "<%= hls_o %>" },
        ...(SHOW_RAW_STREAM || raw
          ? [{ label: "Raw Stream", url: "<%= hls %>" }]
          : []),
      ];

      const players = [];

      videoConfigs.forEach((config, i) => {
        const clone = template.content.cloneNode(true);

        const video = clone.querySelector("video");
        const overlay = clone.querySelector(".overlay");
        const label = clone.querySelector(".label");

        video.id = "video" + i;
        overlay.id = "overlay" + i;
        label.innerText = config.label;

        clone.querySelector(".zoom-in").onclick = () => players[i].zoomIn();
        clone.querySelector(".zoom-out").onclick = () => players[i].zoomOut();
        clone.querySelector(".reset").onclick = () => players[i].reset();
        clone.querySelector(".fullscreen").onclick = () =>
          players[i].fullscreen();

        app.appendChild(clone);

        players.push(createPlayer({ video, overlay, url: config.url }));
      });
      const rs = await fetch(`/api/server-health`);
      const js = await rs.json();
      if (js.status == "error") { document.getElementById("message-health").innerText = js.error }
    }

    function createPlayer({ video, overlay, url }) {
      let scale = 1,
        x = 0,
        y = 0,
        drag = false,
        sx = 0,
        sy = 0;

       let hls = null;
        let retryCount = 0;
        let stallTimer = null;
        let lastTime = -1;
        let isDestroyed = false;
        let isReconnecting = false;

      const apply = () =>
        (video.style.transform = `translate(${x}px,${y}px) scale(${scale})`);


      function showOverlay(msg) {
        overlay.style.display = "flex";
        overlay.innerText = msg;
      }

      function hideOverlay() {
        overlay.style.display = "none";
      }

      function startStallWatcher() {
    clearInterval(stallTimer);
    let frozenCount = 0;
    let freezeCount = 0;

    stallTimer = setInterval(() => {
      if (video.paused || video.ended) return;

      if (video.readyState < 3) {
        frozenCount++;
        if (frozenCount >= 5) {
          frozenCount = 0;
          retryCount = 0;
          init();
        }
        return;
      }

      frozenCount = 0;

      if (hls && hls.liveSyncPosition) {
        const diff = hls.liveSyncPosition - video.currentTime;
        if (diff > 2) {
          try { video.currentTime = hls.liveSyncPosition; } catch(e) {}
        }
      }

      if (video.currentTime === lastTime && lastTime !== -1) {
        freezeCount++;
        if (freezeCount >= 3) {
          freezeCount = 0;
          retryCount = 0;
          init();
        }
      } else {
        freezeCount = 0;
        lastTime = video.currentTime;
      }
    }, 1000);
  }

        function init() {
      if (isDestroyed) return;
      if (isReconnecting) return;
      isReconnecting = true;
      setTimeout(() => { isReconnecting = false; }, 3000);

      clearInterval(stallTimer);
      showOverlay(retryCount > 0 ? `Reconnecting... (#${retryCount})` : "Connecting…");

      if (hls) { hls.destroy(); hls = null; }

        if (!Hls.isSupported()) {
          video.src = url;
          video.play().catch(() => {});
          hideOverlay();
          return;
        }

        hls = new Hls({
          lowLatencyMode: true,
          liveSyncDurationCount: 1,
          liveMaxLatencyDurationCount: 3,
          maxBufferLength: 3,
          maxMaxBufferLength: 6,
          maxBufferHole: 0.3,
          backBufferLength: 3,
          manifestLoadingMaxRetry: 10,
          manifestLoadingRetryDelay: 300,
          levelLoadingMaxRetry: 10,
          levelLoadingRetryDelay: 300,
          fragLoadingMaxRetry: 10,
          fragLoadingRetryDelay: 300,
          enableWorker: true,
          startFragPrefetch: true,
        });

        hls.loadSource(url);
        hls.attachMedia(video);

        hls.on(Hls.Events.MANIFEST_PARSED, () => {
          retryCount = 0;
          hideOverlay();
          video.play().catch(() => {
            video.muted = true;
            video.play().catch(() => {});
          });
          startStallWatcher();
        });

        hls.on(Hls.Events.ERROR, (_, data) => {
        if (data.fatal) console.warn("[HLS] Error:", data.type, data.details, data.fatal);

        if (!data.fatal) {
          // Segment not found — tunggu sebentar lalu retry, JANGAN reconnect
          if (
            data.details === Hls.ErrorDetails.FRAG_LOAD_ERROR ||
            data.details === Hls.ErrorDetails.FRAG_LOAD_TIMEOUT
          ) {
            console.warn("[HLS] Segment gagal load, tunggu 1s...");
            setTimeout(() => {
              if (hls) hls.startLoad();
            }, 1000);
            return;
          }

          if (data.details === Hls.ErrorDetails.BUFFER_STALLED_ERROR) {
            try { if (hls) hls.startLoad(); } catch(e) {}
            return;
          }

          if (
            data.details === Hls.ErrorDetails.MANIFEST_LOAD_ERROR ||
            data.details === Hls.ErrorDetails.MANIFEST_LOAD_TIMEOUT ||
            data.details === Hls.ErrorDetails.LEVEL_LOAD_ERROR
          ) {
            console.warn("[HLS] Manifest belum siap, retry 2s...");
            setTimeout(() => {
              if (hls) hls.loadSource(url);
            }, 2000);
            return;
          }

          return;
        }

        // Fatal error — exponential backoff tapi max 5 detik saja
        retryCount++;
        const delay = Math.min(1000 * retryCount, 5000);
        showOverlay(`Reconnecting... (#${retryCount})`);
        setTimeout(init, delay);
      });

      }

      video.addEventListener("stalled", () => {
        setTimeout(() => {
          try {
            if (hls && hls.liveSyncPosition && isFinite(hls.liveSyncPosition)) {
              video.currentTime = hls.liveSyncPosition;
            }
          } catch(e) {}
        }, 1000);
      });

      video.addEventListener("waiting", () => {
        setTimeout(() => {
          if (video.readyState < 3 && hls && hls.liveSyncPosition) {
            try { video.currentTime = hls.liveSyncPosition; } catch(e) {}
          }
        }, 3000);
      });

      video.addEventListener(
        "wheel",
        (e) => {
          e.preventDefault();
          scale += e.deltaY > 0 ? -0.2 : 0.2;
          scale = Math.max(1, Math.min(scale, 5));
          if (scale === 1) x = y = 0;
          apply();
        },
        { passive: false },
      );

      const p = (e) => (e.touches ? e.touches[0] : e);
      video.addEventListener("mousedown", (e) => {
        if (scale <= 1) return;
        drag = true;
        const d = p(e);
        sx = d.clientX - x;
        sy = d.clientY - y;
      });
      window.addEventListener("mousemove", (e) => {
        if (!drag) return;
        const d = p(e);
        x = d.clientX - sx;
        y = d.clientY - sy;
        apply();
      });
      window.addEventListener("mouseup", () => (drag = false));

      video.addEventListener(
        "touchstart",
        (e) => {
          if (scale <= 1) return;
          drag = true;
          const d = p(e);
          sx = d.clientX - x;
          sy = d.clientY - y;
        },
        { passive: false },
      );
      video.addEventListener(
        "touchmove",
        (e) => {
          if (!drag) return;
          e.preventDefault();
          const d = p(e);
          x = d.clientX - sx;
          y = d.clientY - sy;
          apply();
        },
        { passive: false },
      );
      video.addEventListener("touchend", () => (drag = false));

      init();

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") {
            setTimeout(() => {
                if (video.readyState === 0 || video.paused) {
                    retryCount = 0;
                    init();
                }
            }, 1500);  
        }
    });

      window.addEventListener("online", () => {
        console.warn("[HLS] Internet kembali, reconnect...");
        retryCount = 0;
        init();
      });

      return {
        zoomIn() {
          scale = Math.min(scale + 0.2, 5);
          apply();
        },
        zoomOut() {
          scale = Math.max(scale - 0.2, 1);
          if (scale === 1) x = y = 0;
          apply();
        },
        reset() {
          scale = 1;
          x = 0;
          y = 0;
          apply();
          init();
        },
        fullscreen() {
          video.requestFullscreen?.();
        },
        destroy() {
          isDestroyed = true;
          clearInterval(stallTimer);
          hls?.destroy();
        }
      };
    }

    const cctvIdRaw = "<%= stream.id %>";
    const cctvId = cctvIdRaw.startsWith("cctv_")
      ? cctvIdRaw
      : "cctv_" + cctvIdRaw;

    async function fetchDetectionCounts() {
      try {
        const r = await fetch("/api/counts");
        if (!r.ok) throw new Error("HTTP " + r.status);
        const data = await r.json();

        const c = data[cctvId];
        if (!c) {
          document.getElementById("panel-status").innerText = "Belum ada data";
          return;
        }

        document.getElementById("cnt-motorcycle").innerText = c.motorcycle ?? 0;
        document.getElementById("cnt-car").innerText        = c.car       ?? 0;
        document.getElementById("cnt-bus").innerText        = c.bus       ?? 0;
        document.getElementById("cnt-truck").innerText      = c.truck     ?? 0;

        // Total 
        const total = (c.motorcycle ?? 0) + (c.car   ?? 0)
                    + (c.bus        ?? 0) + (c.truck  ?? 0);
        document.getElementById("cnt-total").innerText = total;

        // Status 
        const statusEl = document.getElementById("panel-status");
        statusEl.innerText = "Live";
        statusEl.style.background = "#134e4a";
        statusEl.style.color      = "#34d399";

        document.getElementById("panel-update").innerText =
          "Update: " + new Date().toLocaleTimeString("id-ID");

      } catch (e) {
        const statusEl = document.getElementById("panel-status");
        statusEl.innerText = "Detektor offline";
        statusEl.style.background = "#450a0a";
        statusEl.style.color      = "#f87171";
      }
    }
    fetchDetectionCounts();
    setInterval(fetchDetectionCounts, 3000);
    
  </script>
</body>

</html>